# Environment Configuration Template
# Copy this to .env and customize as needed

# ==========================================
# Application Environment
# ==========================================
# Options: 'dev' (development), 'prod' (production)
# dev: Larger window (1000x800), debug_mode=true
# prod: Standard window (900x700), optimized, default
ASSISTANT_ENV=prod

# ==========================================
# Groq AI API Integration (Optional)
# ==========================================
# Get your free API key from: https://console.groq.com/
# Leave blank to use built-in AI responses
GROQ_API_KEY=
